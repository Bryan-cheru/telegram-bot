# Multi-Account Risk Management Settings
RISK_PERCENTAGE=1.3
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=10.0

# Multi-Account Performance Settings
BATCH_SIZE=3
BATCH_DELAY=2000

# Memory Management for Production
NODE_OPTIONS=--max-old-space-size=400 --optimize-for-size
UV_THREADPOOL_SIZE=2

# Resource Limits
MAX_CONCURRENT_CONNECTIONS=2
MAX_PERFORMANCE_METRICS_HISTORY=1440
DASHBOARD_POLLING_INTERVAL=30000

# Trading Settings
TEST_MODE=false
DEMO_MODE=false
MAX_TRADE_SIZE=1.3

# Risk Management
ENFORCE_1_1_RR=true

# Order Type Configuration
DEFAULT_ORDER_TYPE=AUTO
USE_SMART_ORDER_TYPE=true
LIMIT_ORDER_SLIPPAGE=5
PENDING_ORDER_EXPIRATION=4
ENABLE_ADVANCED_ORDER_TYPES=true

# Dashboard Configuration - Multi-account mode enabled
DISABLE_SINGLE_ACCOUNT_DASHBOARD=true

# Application Settings
NODE_ENV=production
LOG_LEVEL=info

# Advanced Features
ENABLE_MT5_ORDER_MANAGER=true
CHECK_INTERVAL_SECONDS=10
