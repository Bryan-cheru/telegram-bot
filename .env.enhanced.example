# ===========================================
# ENHANCED TELEGRAM TRADING BOT CONFIGURATION
# ===========================================
# This file contains all configuration for your trading bot
# IMPORTANT: Keep this file secure and never commit to public repositories

# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHANNEL_USERNAME=@your_channel
TELEGRAM_CHANNEL_ID=-1001234567890

# ===========================================
# METAAPI TRADING ACCOUNTS (LIVE TRADING)
# ===========================================
# Format: accountId:brokerName:accountType
# IMPORTANT: These are LIVE TRADING accounts - real money at risk!

# Primary Trading Accounts
METAAPI_ACCOUNTS=67452862:FTMO-Server3:live,67669901:IFPro-Trade:live,67669941:Pepperstone-MT5-Live01:live,67669945:Pepperstone-MT5-Live02:live

# MetaAPI Configuration
METAAPI_TOKEN=YOUR_METAAPI_TOKEN

# ===========================================
# ENHANCED RISK MANAGEMENT PARAMETERS
# ===========================================

# Core Risk Settings
DEFAULT_RISK_PERCENTAGE=1.3
MAX_RISK_PERCENTAGE=2.0
MIN_RISK_PERCENTAGE=0.5

# Position Sizing Limits
MAX_POSITION_SIZE=1.0
MIN_POSITION_SIZE=0.01
MAX_DAILY_RISK=5.0

# Account Safety Parameters
MIN_ACCOUNT_BALANCE=1000
MAX_DRAWDOWN_PERCENTAGE=10.0
MAX_DAILY_TRADES=10

# Market Condition Risk Adjustments
NEWS_RISK_REDUCTION=0.5
HIGH_VOL_RISK_REDUCTION=0.7
LOW_VOL_RISK_REDUCTION=0.8

# Emergency Controls
EMERGENCY_STOP_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=3.0
AUTO_RECOVERY_ENABLED=true

# ===========================================
# OCR FALLBACK SYSTEM CONFIGURATION
# ===========================================

# OCR Processing Settings
OCR_MAX_RETRIES=3
OCR_RETRY_DELAY=1000
OCR_CONFIDENCE_THRESHOLD=0.7

# OCR Enhancement Features
OCR_PREPROCESSING=true
OCR_TEXT_ENHANCEMENT=true
OCR_PATTERN_MATCHING=true
OCR_BASIC_FALLBACK=true

# Manual Review System
OCR_MANUAL_REVIEW=false

# ===========================================
# DASHBOARD CONFIGURATION
# ===========================================
DASHBOARD_PORT=3001
DASHBOARD_HOST=0.0.0.0

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ===========================================
# TRADING STRATEGY PARAMETERS
# ===========================================

# Entry Strategy
ENTRY_METHOD=ZONE_AVERAGE
ZONE_PADDING_PERCENTAGE=0.1

# Exit Strategy
TAKE_PROFIT_METHOD=PROGRESSIVE
STOP_LOSS_TRAIL=false

# Order Management
ORDER_TIMEOUT_MINUTES=60
MAX_SLIPPAGE_POINTS=3

# ===========================================
# SYMBOL-SPECIFIC CONFIGURATIONS
# ===========================================

# Symbol Risk Multipliers (1.0 = normal risk)
SYMBOL_RISK_XAUUSD=1.0
SYMBOL_RISK_XAGUSD=1.2
SYMBOL_RISK_EURUSD=0.8
SYMBOL_RISK_GBPUSD=1.0
SYMBOL_RISK_USDJPY=0.9
SYMBOL_RISK_US30=1.5
SYMBOL_RISK_NAS100=1.8
SYMBOL_RISK_BTCUSD=2.0

# ===========================================
# LIVE TRADING SAFETY WARNINGS
# ===========================================
# WARNING: This bot is configured for LIVE TRADING
# - Real money is at risk
# - Monitor positions actively
# - Ensure sufficient account balance
# - Test thoroughly before deployment
# ===========================================

# Production Environment Flag
NODE_ENV=production
IS_LIVE_TRADING=true

# ===========================================
# BACKUP & RECOVERY
# ===========================================
BACKUP_TRADES=true
BACKUP_INTERVAL_HOURS=24
RECOVERY_MODE=false

# ===========================================
# EXTERNAL SERVICES
# ===========================================

# News & Economic Calendar
NEWS_API_KEY=YOUR_NEWS_API_KEY
ECONOMIC_CALENDAR_URL=https://api.example.com/calendar

# Market Data
MARKET_DATA_PROVIDER=metaapi
REAL_TIME_QUOTES=true

# ===========================================
# NOTIFICATION SETTINGS
# ===========================================

# Telegram Notifications
NOTIFY_TRADES=true
NOTIFY_ERRORS=true
NOTIFY_RISK_WARNINGS=true
NOTIFY_DAILY_SUMMARY=true

# Emergency Contacts
EMERGENCY_TELEGRAM_ID=123456789
ADMIN_TELEGRAM_ID=987654321

# ===========================================
# DEVELOPMENT & TESTING
# ===========================================

# Debug Settings (set to false for production)
DEBUG_MODE=false
VERBOSE_LOGGING=false
DRY_RUN=false

# Testing
ENABLE_BACKTESTING=false
PAPER_TRADING=false

# ===========================================
# PERFORMANCE MONITORING
# ===========================================
PERFORMANCE_TRACKING=true
METRICS_COLLECTION=true
HEALTH_CHECK_INTERVAL=30

# ===========================================
# SECURITY SETTINGS
# ===========================================
ENCRYPTION_KEY=your-secret-encryption-key
SESSION_SECRET=your-session-secret
API_RATE_LIMIT=100
