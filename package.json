{
  "name": "telegram-trading-bot",
  "version": "1.0.0",
  "description": "Telegram bot that processes trading screenshots and executes trades on MT5",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "setup": "node bot-setup.js",
    "railway:build": "npm run build",
    "railway:start": "npm run start",
    "railway:debug": "node health-check.js",
    "health-check": "curl -f http://localhost:3000/health || exit 1",
    "electron": "npm run build && electron electron/main.js",
    "electron:dev": "electron electron/main.js",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "electron:pack": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "telegram",
    "bot",
    "trading",
    "mt5",
    "ocr"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "jshint": "^2.13.6",
    "metaapi.cloud-sdk": "^29.2.0",
    "sharp": "^0.32.6",
    "telegraf": "^4.15.4",
    "tesseract.js": "^5.0.4",
    "winston": "^3.11.0",
    "zeromq": "^6.0.0-beta.20"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.telegrambot.trading",
    "productName": "Telegram Trading Bot",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "MT5_Files",
        "to": "MT5_Files"
      },
      {
        "from": "eng.traineddata",
        "to": "eng.traineddata"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telegram Trading Bot"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bryan-cheru",
        "repo": "telegram-bot"
      }
    ]
  }
}
