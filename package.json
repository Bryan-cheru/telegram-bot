{
  "name": "telegram-trading-bot",
  "version": "1.0.0",
  "description": "Telegram bot that processes trading screenshots and executes trades on MT5",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "setup": "node bot-setup.js",
    "railway:build": "npm run build",
    "railway:start": "npm run start",
    "health-check": "curl -f http://localhost:3000/health || exit 1",
    "electron": "electron electron/main.js",
    "electron:dev": "npm run build && electron electron/main.js",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --win --x64"
  },
  "keywords": [
    "telegram",
    "bot",
    "trading",
    "mt5",
    "ocr"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "jshint": "^2.13.6",
    "metaapi.cloud-sdk": "^29.2.0",
    "sharp": "^0.32.6",
    "telegraf": "^4.15.4",
    "tesseract.js": "^5.0.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.telegrambot.tradingbot",
    "productName": "Telegram Trading Bot",
    "copyright": "Copyright © 2025 Telegram Trading Bot",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      ".env.example",
      "README.md",
      "SETUP.md",
      "DESKTOP_APP_GUIDE.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "Telegram Trading Bot"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telegram Trading Bot"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
