RISK_CHALLENGE_TYPE=proprietary
DAILY_LOSS_LIMIT_PERCENT=2.0
TOTAL_DRAWDOWN_LIMIT_PERCENT=5.0
MIN_TRADING_DAYS=4

# Risk-Reward Configuration
ENFORCE_1_1_RR=true
RISK_MANAGEMENT_TYPE=instantfunding

