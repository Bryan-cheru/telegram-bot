UV_THREADPOOL_SIZE=4

# Resource Limits (Conservative for Render)
MAX_CONCURRENT_CONNECTIONS=5
MAX_PERFORMANCE_METRICS_HISTORY=100
DASHBOARD_POLLING_INTERVAL=45000
MAX_SSE_CONNECTIONS=10
OCR_WORKER_THREADS=2
CONNECTION_POOL_SIZE=5

# Multi-Account Performance Settings
BATCH_SIZE=3
BATCH_DELAY=2000

# ===========================================
# INSTANTFUNDING SYMBOL CONFIGURATION
# ===========================================

# InstantFunding Symbol Configuration (with .x suffix)
ENABLE_INSTANTFUNDING_SYMBOLS=true
INSTANTFUNDING_BROKER_TYPE=instantfunding

# Note: Price validation removed - MetaAPI provides real-time market prices
# No hardcoded ranges needed - dynamic validation through broker feeds

# ===========================================
# TRADING CONFIGURATION
# ===========================================

# Order Type Configuration
DEFAULT_ORDER_TYPE=AUTO
USE_SMART_ORDER_TYPE=true
LIMIT_ORDER_SLIPPAGE=5
PENDING_ORDER_EXPIRATION=4
ENABLE_ADVANCED_ORDER_TYPES=true

# Advanced Features
ENABLE_MT5_ORDER_MANAGER=true
CHECK_INTERVAL_SECONDS=10

# Dashboard Configuration
DISABLE_SINGLE_ACCOUNT_DASHBOARD=false

# Maximum Trade Size (Conservative)
MAX_TRADE_SIZE=0.1

