# Production Environment (Render.com)
NODE_ENV=production
INSTANCE_TYPE=production

# Dashboard Configuration  
DASHBOARD_PORT=3000
DASHBOARD_ENABLED=true

# Bot Configuration
BOT_ENABLED=true
BOT_WEBHOOK_ENABLED=true  # Use webhooks for production

# Trading Configuration - Production settings
MAX_TRADE_SIZE=0.1
RISK_PERCENTAGE=2
ENFORCE_1_1_RR=true

# Logging
LOG_LEVEL=info

# NOTE: Production secrets should be set in Render.com environment variables:
# - BOT_TOKEN (your main production bot token)
# - ALLOWED_CHANNEL_ID
# - ALLOWED_CHANNEL_USERNAME  
# - METAAPI_TOKEN
# - METAAPI_ACCOUNTS (your live trading accounts)
