{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules", 
    "dist",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.old",
    "**/*.ts.old",
    "src/ml/tradingML.ts",
    "src/ml/integration-examples.ts",
    "src/api.old/**/*"
  ]
}
