# =================================================================
# TELEGRAM TRADING BOT CONFIGURATION
# =================================================================

# ----------------- TELEGRAM BOT SETTINGS -----------------
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Channel or group ID where the bot should listen for signals
# To get this: Add bot to channel, send a message, check logs or use @userinfobot
ALLOWED_CHANNEL_ID=-1001234567890

# ----------------- TRADING MODE -----------------
# Options: 'simulation', 'metaapi', 'local'
# simulation: Test mode, no real trades
# metaapi: Cloud-based trading via MetaAPI
# local: File-based communication with local MT5
TRADING_MODE=simulation

# ----------------- METAAPI CONFIGURATION -----------------
# Get these from https://app.metaapi.cloud/
# Required for 'metaapi' trading mode
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here

# ----------------- LOCAL MT5 CONFIGURATION -----------------
# For local MT5 connection (legacy ZeroMQ method)
# Only used when TRADING_MODE=local
MT5_HOST=localhost
MT5_PORT=18812

# ----------------- TRADING PARAMETERS -----------------
# Maximum position size per trade
MAX_TRADE_SIZE=0.1

# Risk percentage per trade (used for position sizing)
RISK_PERCENTAGE=2

# Enable test mode (overrides TRADING_MODE)
TEST_MODE=false

# ----------------- LOGGING CONFIGURATION -----------------
# Log level: error, warn, info, debug
LOG_LEVEL=info

# ----------------- RAILWAY DEPLOYMENT (Optional) -----------------
# Port for health check server (Railway will set this automatically)
PORT=3000

# ----------------- ADVANCED SETTINGS (Optional) -----------------
# Maximum spread allowed for trade execution (in pips)
MAX_SPREAD_PIPS=3.0

# Timeout for OCR processing (in milliseconds)
OCR_TIMEOUT=30000

# Enable enhanced trade parser with confidence scoring
ENHANCED_PARSER=true

# Minimum confidence score for trade signal acceptance (0.0-1.0)
MIN_CONFIDENCE=0.7

# =================================================================
# SETUP INSTRUCTIONS:
# 
# 1. Copy this file to .env in the same directory
# 2. Fill in your actual values (remove the _here suffixes)
# 3. Never commit the .env file to version control
# 4. Start with TRADING_MODE=simulation for testing
# 
# For MetaAPI setup:
# - Sign up at https://app.metaapi.cloud/
# - Create an account and get your token/account ID
# - Set TRADING_MODE=metaapi
# 
# For local MT5 setup:
# - Set up ZeroMQ Expert Advisor in MT5
# - Configure MT5_HOST and MT5_PORT
# - Set TRADING_MODE=local
# =================================================================
