# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_CHANNEL_ID=your_channel_id_here

# MetaAPI Configuration
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNTS=account1,account2,account3

# Trading Configuration (Optional - has defaults)
MAX_TRADE_SIZE=0.1
RISK_PERCENTAGE=2
ENFORCE_1_1_RR=true
DEFAULT_ORDER_TYPE=MARKET
USE_SMART_ORDER_TYPE=true
LIMIT_ORDER_SLIPPAGE=5
PENDING_ORDER_EXPIRATION=4
ENABLE_ADVANCED_ORDER_TYPES=true

# Logging Configuration (Optional)
LOG_LEVEL=info

# Environment
NODE_ENV=development
